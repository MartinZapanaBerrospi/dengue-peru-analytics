                "textRuns": [
                  {
                    "value": "Lectura",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#1b1f24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• 2023 multiplicó por 4,1 los casos de 2022 y fue 3,8 veces la epidemia de 2017.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1b1f24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Años de alta transmisión (más de 50 mil casos): 2017, 2022, 2023, 2024.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1b1f24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Fallecidos 2012–2024: 1 255. La letalidad no subió con los casos: 0,17 % en 2023 y 0,10 % en 2024.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1b1f24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Más casos pueden ser más infección, más pruebas o más notificación. 2025 y 2026 no están en el archivo abierto.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1b1f24"
                    }
                  }
                ]
              }
            ]
          }
        }
