                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1b1f24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cada medida del tablero se comparó con el mismo cálculo en Python: 9 702 comparaciones, diferencia máxima 4,9 × 10⁻¹⁵.",
