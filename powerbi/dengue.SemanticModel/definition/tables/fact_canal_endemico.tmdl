	column sobre_canal
		dataType: int64
		isHidden
		lineageTag: 820b1564-a3bf-5633-8536-f3df9704d1b1
		summarizeBy: none
		sourceColumn: sobre_canal

		annotation SummarizationSetBy = Automatic

	partition fact_canal_endemico = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_canal_endemico.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"departamento_id", type text}, {"anio", Int64.Type}, {"semana", Int64.Type}, {"casos", Int64.Type}, {"mediana_historica", type number}, {"umbral", type number}, {"sobre_canal", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
