/// Semana epidemiológica (1 a 53) y su trimestre. La 53 existe solo en algunos años.
table dim_semana
	lineageTag: bd3dd2ee-71b7-5855-8fc6-51ecc0b370af

	/// Semana epidemiológica
	column semana
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 4282b58b-1e09-5a1e-ab60-504ef6f7139b
		summarizeBy: none
		sourceColumn: semana

		annotation SummarizationSetBy = Automatic

	column trimestre_epi
		dataType: string
		lineageTag: 536e738c-bb53-5628-b9b5-fec21062ede0
		summarizeBy: none
		sourceColumn: trimestre_epi

		annotation SummarizationSetBy = Automatic

	partition dim_semana = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_semana.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"semana", Int64.Type}, {"trimestre_epi", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
