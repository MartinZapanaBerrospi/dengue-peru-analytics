		summarizeBy: none
		sourceColumn: casos_con_edad

		annotation SummarizationSetBy = Automatic

	partition fact_caso = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_caso.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"anio", Int64.Type}, {"semana", Int64.Type}, {"ubigeo", type text}, {"forma_clinica_id", Int64.Type}, {"grupo_edad_id", Int64.Type}, {"sexo_id", type text}, {"casos", Int64.Type}, {"edad_suma", type number}, {"casos_con_edad", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
