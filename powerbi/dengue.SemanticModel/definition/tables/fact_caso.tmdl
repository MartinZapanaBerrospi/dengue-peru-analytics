/// Casos de dengue por año, semana, distrito, forma clínica, grupo de edad y sexo (2000–2024). Solo hay fila si hubo al menos un caso.
table fact_caso
	lineageTag: 48c29908-daeb-541e-b7b7-b48a32d14ed9

	column anio
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 399e2f63-d360-5b60-bba8-cb7525d75937
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = Automatic

	column semana
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 37d88380-f135-5a06-aac4-8c226b529837
		summarizeBy: none
		sourceColumn: semana

		annotation SummarizationSetBy = Automatic

	column ubigeo
		dataType: string
		isHidden
		lineageTag: 51b0e482-69aa-549e-b798-c127e0d09ea6
		summarizeBy: none
		sourceColumn: ubigeo

		annotation SummarizationSetBy = Automatic

	column forma_clinica_id
		dataType: int64
		isHidden
		lineageTag: c678a3da-065e-5c78-9371-a5ec09638862
		summarizeBy: none
		sourceColumn: forma_clinica_id

		annotation SummarizationSetBy = Automatic

	column grupo_edad_id
		dataType: int64
		isHidden
		lineageTag: 06d470b9-3d01-5060-99c6-9624b4007fef
		summarizeBy: none
		sourceColumn: grupo_edad_id

		annotation SummarizationSetBy = Automatic

	column sexo_id
		dataType: string
		isHidden
		lineageTag: de5692c1-e955-530b-ad8e-f432de2033c4
		summarizeBy: none
		sourceColumn: sexo_id

		annotation SummarizationSetBy = Automatic

	column casos
		dataType: int64
		isHidden
		lineageTag: 804bdeba-78a5-5c9c-9201-d645ba9503c1
		summarizeBy: none
		sourceColumn: casos

		annotation SummarizationSetBy = Automatic

	column edad_suma
		dataType: double
		isHidden
		lineageTag: b7ae6c8e-2d6a-58f1-b395-b14415936ff9
		summarizeBy: none
		sourceColumn: edad_suma

		annotation SummarizationSetBy = Automatic

	column casos_con_edad
		dataType: int64
		isHidden
