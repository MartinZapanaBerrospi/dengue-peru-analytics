    SELECTCOLUMNS ( SUMMARIZE ( fact_canal_nacional, dim_anio[anio], dim_semana[semana] ), "contexto", "anio_semana", "clave", FORMAT ( dim_anio[anio], "0" ) & "|" & FORMAT ( dim_semana[semana], "0" ), "medida", "Mediana histórica (país)", "valor", FORMAT ( [Mediana histórica (país)], "General Number" ) )
)
